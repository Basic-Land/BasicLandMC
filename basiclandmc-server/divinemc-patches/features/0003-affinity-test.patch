index 0000000000000000000000000000000000000000..1bf3b3f71606c741b195e0b8d1e4b638c26e4459
--- /dev/null
+++ b/src/main/java/org/bxteam/divinemc/util/NamedAgnosticThreadFactoryAffinity.java
@@ -0,0 +1,36 @@
+package org.bxteam.divinemc.util;
+
+import it.unimi.dsi.fastutil.ints.IntArrayList;
+import net.openhft.affinity.AffinityLock;
+import org.jspecify.annotations.NonNull;
+
+import java.util.concurrent.atomic.AtomicInteger;
+
+public class NamedAgnosticThreadFactoryAffinity<T extends Thread> extends NamedAgnosticThreadFactory<T> {
+    private final IntArrayList affinityList;
+    private final AtomicInteger threadNumber = new AtomicInteger();
+
+    public NamedAgnosticThreadFactoryAffinity(
+        final String name,
+        final ThreadBuilderFunction<T> typeOfThread,
+        final int priority,
+        final IntArrayList affinityList
+    ) {
+        super(name, typeOfThread, priority);
+        if (affinityList == null || affinityList.isEmpty()) {
+            throw new IllegalArgumentException("affinityList must not be null or empty");
+        }
+        this.affinityList = affinityList;
+    }
+
+    @Override
+    public Thread newThread(@NonNull Runnable runnable) {
+        final int cpuId = affinityList.getInt(Math.floorMod(threadNumber.getAndIncrement(), affinityList.size()));
+        return super.newThread(() -> {
+            try (AffinityLock ignored = AffinityLock.acquireLock(cpuId)) {
+                runnable.run();
+            }
+        });
+    }
+}
