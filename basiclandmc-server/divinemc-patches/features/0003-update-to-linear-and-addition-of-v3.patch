-    private void parseLinearV2(ByteBuffer buffer) throws IOException {
-        buffer.getLong(); // Skip newestTimestamp (Long)
-        gridSize = buffer.get();
-        if (gridSize != 1 && gridSize != 2 && gridSize != 4 && gridSize != 8 && gridSize != 16 && gridSize != 32)
