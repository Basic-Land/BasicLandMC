diff --git a/src/main/java/org/bxteam/divinemc/command/subcommands/TickTimes.java b/src/main/java/org/bxteam/divinemc/command/subcommands/TickTimes.java
new file mode 100644
index 0000000000000000000000000000000000000000..eb13ef3f6a11558c22513b1c26d13c9e677bf933
--- /dev/null
+++ b/src/main/java/org/bxteam/divinemc/command/subcommands/TickTimes.java
@@ -0,0 +1,112 @@
+package org.bxteam.divinemc.command.subcommands;
+
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.event.ClickCallback;
+import net.kyori.adventure.text.event.ClickEvent;
+import net.kyori.adventure.text.event.HoverEvent;
+import net.kyori.adventure.text.format.NamedTextColor;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerPlayer;
+import org.bukkit.command.CommandSender;
+import org.bukkit.craftbukkit.entity.CraftPlayer;
+import org.bukkit.permissions.PermissionDefault;
+import org.bxteam.divinemc.command.DivineCommand;
+import org.bxteam.divinemc.command.DivineSubCommandPermission;
+import org.jetbrains.annotations.NotNull;
+
+import java.text.DecimalFormat;
+import java.time.Duration;
+import java.util.List;
+import java.util.Map;
+import java.util.stream.Collectors;
+
+import static net.kyori.adventure.text.format.NamedTextColor.*;
+
+public final class TickTimes extends DivineSubCommandPermission {
+    public static final String LITERAL_ARGUMENT = "ticktimes";
+    public static final String PERM = DivineCommand.BASE_PERM + "." + LITERAL_ARGUMENT;
+    private static final DecimalFormat DF = new DecimalFormat("########0.0");
+    private static final Component SLASH = Component.text("/");
+    private static final ClickCallback.Options options = ClickCallback.Options.builder().uses(-1).lifetime(Duration.ofMinutes(1)).build();
+    public TickTimes() {
+        super(PERM, PermissionDefault.OP);
+    }
+
+    @Override
+    public boolean execute(@NotNull CommandSender sender, @NotNull String subCommand, String @NotNull [] args) {
+        List<ServerPlayer> onlinePlayers = MinecraftServer.getServer().getPlayerList().players;
+        
+        if (onlinePlayers.isEmpty()) {
+            sender.sendMessage(Component.text("No players online.", NamedTextColor.GRAY));
+            return true;
+        }
+
+        Map<String, List<ServerPlayer>> playersByWorld = onlinePlayers.stream()
+                .collect(Collectors.groupingBy(p -> p.level().getWorld().getName()));
+
+        List<Map.Entry<String, List<ServerPlayer>>> sortedWorlds = playersByWorld.entrySet().stream()
+                .sorted((e1, e2) -> Integer.compare(e2.getValue().size(), e1.getValue().size()))
+                .toList();
+
+        sender.sendMessage(Component.text("━━━━━━━━━━━━━ ", GOLD)
+                .append(Component.text("Player Tick Times ", YELLOW))
+                .append(Component.text("(last/1s/5s)", NamedTextColor.GRAY))
+                .append(Component.text(" ━━━━━━━━━━━━━", GOLD)));
+
+        for (int i = 0; i < sortedWorlds.size(); i++) {
+            Map.Entry<String, List<ServerPlayer>> entry = sortedWorlds.get(i);
+            String worldName = entry.getKey();
+            List<ServerPlayer> players = entry.getValue();
+
+            players.sort((p1, p2) -> Double.compare(
+                    p2.avgTickTimeNanos.average().orElse(0),
+                    p1.avgTickTimeNanos.average().orElse(0)
+            ));
+
+            sender.sendMessage(Component.text("➤ ", YELLOW)
+                    .append(Component.text(worldName, GOLD))
+                    .append(Component.text(" (" + players.size() + " players)", GRAY)));
+
+            for (ServerPlayer player : players) {
+                double last = player.avgTickTimeNanos.last().orElse(0) * 1.0E-6;
+                double avg1s = player.avgTickTimeNanos.averageLast(20).orElse(0.0) * 1.0E-6;
+                double avg5s = player.avgTickTimeNanos.average().orElse(0.0) * 1.0E-6;
+
+                Component stats = Component.text(" [", GRAY)
+                        .append(getColoredValue(last))
+                        .append(SLASH)
+                        .append(getColoredValue(avg1s))
+                        .append(SLASH)
+                        .append(getColoredValue(avg5s))
+                        .append(Component.text("]", GRAY));
+
+                Component playerLine = Component.text("  - ", GRAY)
+                        .append(Component.text(player.getScoreboardName(), AQUA))
+                        .append(stats)
+                        .clickEvent(ClickEvent.callback(audience -> {
+                            if (audience instanceof CraftPlayer sourcePlayer) {
+                                MinecraftServer.getServer().execute(() -> sourcePlayer.teleport(player.getBukkitEntity().getLocation()));
+                            }
+                        }, options))
+                        .hoverEvent(HoverEvent.showText(Component.text("Click to teleport", GREEN)));
+
+                sender.sendMessage(playerLine);
+            }
+
+            if (i < sortedWorlds.size() - 1) {
+                sender.sendMessage(Component.empty());
+            }
+        }
+
+        return true;
+    }
+
+    private static Component getColoredValue(double value) {
+        NamedTextColor color = value >= 50 ? RED
+                : value >= 40 ? YELLOW
+                : value >= 30 ? GOLD
+                : value >= 20 ? GREEN
+                : AQUA;
+        return Component.text(DF.format(value) + "ms", color);
+    }
+}
