Subject: [PATCH] affinity-test


diff --git a/src/main/java/org/bxteam/divinemc/util/NamedAgnosticThreadFactoryAffinity.java b/src/main/java/org/bxteam/divinemc/util/NamedAgnosticThreadFactoryAffinity.java
index 1bf3b3f71606c741b195e0b8d1e4b638c26e4459..0b0690c25665ebecba54a6700f3af64fe3174b2e 100644
--- a/src/main/java/org/bxteam/divinemc/util/NamedAgnosticThreadFactoryAffinity.java
+++ b/src/main/java/org/bxteam/divinemc/util/NamedAgnosticThreadFactoryAffinity.java
@@ -4,6 +4,8 @@ import it.unimi.dsi.fastutil.ints.IntArrayList;
 import net.openhft.affinity.AffinityLock;
 import org.jspecify.annotations.NonNull;
 
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
 import java.util.concurrent.atomic.AtomicInteger;
 
 public class NamedAgnosticThreadFactoryAffinity<T extends Thread> extends NamedAgnosticThreadFactory<T> {
@@ -27,6 +29,17 @@ public class NamedAgnosticThreadFactoryAffinity<T extends Thread> extends NamedA
     public Thread newThread(@NonNull Runnable runnable) {
         final int cpuId = affinityList.getInt(Math.floorMod(threadNumber.getAndIncrement(), affinityList.size()));
         return super.newThread(() -> {
+            if (cpuId == 0) {
+                try {
+                    Method tryAcquireLock = AffinityLock.class.getDeclaredMethod("tryAcquireLock", boolean.class, int.class);
+                    tryAcquireLock.setAccessible(true);
+                    tryAcquireLock.invoke(null, true, cpuId);
+                } catch (NoSuchMethodException | InvocationTargetException | IllegalAccessException e) {
+                    throw new RuntimeException(e);
+                }
+                runnable.run();
+                return;
+            }
             try (AffinityLock ignored = AffinityLock.acquireLock(cpuId)) {
                 runnable.run();
             }
