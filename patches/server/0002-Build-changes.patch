+++ b/build.gradle.kts
@@ -108,14 +108,14 @@ tasks.jar {
         val gitBranch = git("rev-parse", "--abbrev-ref", "HEAD").getText().trim() // Paper
         attributes(
             "Main-Class" to "org.bukkit.craftbukkit.Main",
-            "Implementation-Title" to "DivineMC", // DivineMC
+            "Implementation-Title" to "BasicLandMC", // DivineMC // BL
             "Implementation-Version" to implementationVersion,
             "Implementation-Vendor" to date, // Paper
-            "Specification-Title" to "DivineMC", // DivineMC
+            "Specification-Title" to "BasicLandMC", // DivineMC // BL
             "Specification-Version" to project.version,
-            "Specification-Vendor" to "BX Team", // DivineMC + BX Team
